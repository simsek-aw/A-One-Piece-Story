# Kopiere diese Datei nach ".env" und passe die Werte an.

# Welcher KI-Provider steuert den Spielleiter?
#   mock      -> deterministische Platzhalter-Engine (kein API-Key nötig)
#   anthropic -> echter Claude als Spielleiter (ANTHROPIC_API_KEY nötig)
AI_PROVIDER=mock

# Nur für AI_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
# Modell (Standard: claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# Echtzeit-Tagestakt:
#   ACTIONS_PER_DAY      = wie viele "große" Aktionen pro In-Game-Tag (Default 1)
#   DAY_COOLDOWN_SECONDS = echte Wartezeit bis zum nächsten Tag (Default 45)
# Für "richtig Echtzeit" z.B. DAY_COOLDOWN_SECONDS=3600 (1h) oder 86400 (1 Tag).
# Zum entspannten Solo-Testen ruhig hochsetzen, z.B. ACTIONS_PER_DAY=5.
ACTIONS_PER_DAY=1
DAY_COOLDOWN_SECONDS=45

# Server-Port
PORT=3000
