# Kopiere diese Datei nach ".env" und passe die Werte an.

# Welcher KI-Provider ist beim ersten Start vorausgewählt? Jeder Anbieter mit
# hinterlegtem API-Key erscheint zusätzlich oben im Spielleiter-Menü.
#   mock      -> deterministische Platzhalter-Engine (kein API-Key nötig)
#   gemini    -> echter Spielleiter über Google Gemini (kostenloses Kontingent
#                über https://aistudio.google.com/apikey — empfohlen ohne
#                OpenAI-Guthaben)
#   openrouter -> echter Spielleiter über OpenRouter (ein Key, sehr viele
#                 Modelle — auch kostenlose mit ":free"-Endung, siehe
#                 https://openrouter.ai/models?max_price=0)
#   deepseek  -> direkter DeepSeek-Zugang (DEEPSEEK_API_KEY nötig)
#   openai    -> echter Spielleiter über OpenAI (OPENAI_API_KEY nötig)
#   anthropic -> echter Spielleiter über Claude (ANTHROPIC_API_KEY nötig)
AI_PROVIDER=mock

# Gemini konfigurieren und im Menü verfügbar machen:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: Kontingent-Kette, Reihenfolge = Priorität (bestes zuerst). Das
# Menü zeigt "Gemini · Automatisch" (wechselt bei 429/Kontingent-Limit
# selbstständig zum nächsten Modell) plus jedes Modell einzeln zum Pinnen.
# Standard (Stand Sommer 2026) deckt beide Generationen ab: 3.x zuerst (Lite-
# Varianten mit deutlich höherem Tageskontingent als die Hauptmodelle), dann
# 2.5/2.0 als Sicherheitsnetz. In Google AI Studio nachsehen, falls sich die
# genauen Modell-IDs inzwischen geändert haben.
# GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# OpenRouter konfigurieren und im Menü verfügbar machen:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Optional: mehrere vollständige OpenRouter-Modell-IDs, kommagetrennt. Jedes
# Modell erscheint separat im Spielleiter-Menü. OPENROUTER_MODEL ist der Standard.
OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,poolside/laguna-s-2.1:free
# Optional, nur fürs OpenRouter-eigene Ranking:
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=A One Piece Story

# DeepSeek konfigurieren und im Menü verfügbar machen:
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI konfigurieren und im Menü verfügbar machen:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude konfigurieren und im Menü verfügbar machen:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Echte KI-Bild-Panels (Szenen, Schlüsselmomente, Profilbild) — optional,
# unabhängig vom Text-Spielleiter oben wählbar. Krea hat bei Aktivierung
# Vorrang vor Gemini und OpenAI. Ohne Bildanbieter bleiben die kostenlosen SVGs.
KREA_API_KEY=
KREA_IMAGES=0
KREA_IMAGE_MODEL=image/krea/krea-2/medium
KREA_CREATIVITY=low
GEMINI_IMAGES=0
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_IMAGES=0
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=low

# Dauerhafte Spielstände in Supabase (optional). Beide Werte gehören NUR in die
# Server-Umgebung (lokal .env / Render Environment), niemals ins Frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-Port
PORT=3000
